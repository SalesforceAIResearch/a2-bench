# =============================================================================
# .env.example — copy to `.env` and fill in. `.env` is gitignored.
#
# The loader auto-reads `.env` next to the experiment yaml before parsing,
# so any `${env:VARNAME}` reference in the yaml resolves without you having
# to `export` first. Shell env wins — a one-off `export FOO=bar` always
# overrides this file.
#
# Format: KEY=value per line. `#` starts a line comment. Quotes around the
# value are stripped. Lines starting with `export ` are tolerated.
# =============================================================================

# ---- LLM API keys (only the ones you actually use) -------------------------
# Model auth is direct — each harness authenticates with its own provider.
# These are propagated transparently into the sandbox container.

# codex (provider=direct)
OPENAI_API_KEY=

# claude_code (provider=direct)
ANTHROPIC_API_KEY=

# claude_code (provider=openrouter) — drive ANY OpenRouter model through the
# claude_code harness (model: "vendor/model", e.g. openai/gpt-5). sk-or-... key.
OPENROUTER_API_KEY=

# ---- claude_code provider=bedrock (optional) --------------------------------
# Claude Code's native AWS Bedrock routing; either an API key ...
#AWS_BEARER_TOKEN_BEDROCK=
# Bedrock via an LLM gateway: token auth against the gateway.
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BEDROCK_BASE_URL=
#CLAUDE_CODE_SKIP_BEDROCK_AUTH=1

# ---- claude_code provider=vertex (optional) ---------------------------------
# Vertex with gcloud application-default credentials (run once on the host):
#   gcloud auth application-default login
#ANTHROPIC_VERTEX_PROJECT_ID=
#CLOUD_ML_REGION=

# ---- cursor (Cursor backend) ----------------------
# crsr_... API key. 
CURSOR_API_KEY=